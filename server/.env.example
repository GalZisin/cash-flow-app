# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored - never commit real passwords or API keys.

# --- SQL Server (database name: CashFlowDB) ---------------------------------------------
# SQL login (recommended - create it with db/create-app-user.sql):
DB_CONNECTION_STRING=Server=localhost,1433;Database=CashFlowDB;User Id=cashflow_app;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=true

# Named instance (e.g. SQL Server Express) - needs the "SQL Server Browser" service running:
# DB_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=CashFlowDB;User Id=cashflow_app;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=true

# Windows Authentication (needs: npm install msnodesqlv8, and the Microsoft ODBC Driver for SQL Server):
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=CashFlowDB;Trusted_Connection=yes;TrustServerCertificate=yes

# --- Server -----------------------------------------------------------------------------
# PORT=3000
# LOG_LEVEL=INFO
# Allowed browser origins (comma separated). Default: http://localhost:4300. Use * to allow all.
# CORS_ORIGIN=http://localhost:4300
# Max JSON request body (default 1mb)
# JSON_BODY_LIMIT=1mb
# Set to 1 when running behind a reverse proxy (so rate limiting sees the real client IP)
# TRUST_PROXY=0

# --- AI ---------------------------------------------------------------------------------
# Full guide with every option: docs/ai/AI_PROVIDERS.md
#
# AI_PROVIDER=ollama   -> Ollama /api/generate (local machine, or another machine on the LAN)
# AI_PROVIDER=openai   -> any OpenAI-compatible /chat/completions API (Groq, OpenRouter, Gemini, Mistral, LM Studio, ...)
#
# 1) Ollama on this machine (default, started by "npm run dev:ai" / run-all-ai.bat):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=qwen3:8b
#
# 2) Ollama on another machine (on that machine: set OLLAMA_HOST=0.0.0.0 and restart Ollama):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://192.168.1.50:11434
# AI_MODEL=qwen3:8b
#
# 3) Groq (free tier, no credit card, fast). Key: https://console.groq.com/keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# AI_API_KEY=gsk_...
#
# 4) OpenRouter (free ":free" models). Key: https://openrouter.ai/keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen3-235b-a22b:free
# AI_API_KEY=sk-or-...
#
# 5) Google Gemini (free tier). Key: https://aistudio.google.com/apikey
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=AIza...
#
# 6) Mistral (free plan). Key: https://console.mistral.ai/api-keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-small-latest
# AI_API_KEY=...
#
# Per-request timeout in milliseconds (default 60000)
# AI_TIMEOUT_MS=60000
# How long the computed financial summary is cached between AI calls (default 60000, 0 = off)
# AI_SUMMARY_CACHE_MS=60000
# Max AI requests per minute per client (default 30)
# AI_RATE_LIMIT_PER_MINUTE=30
